  <DataSets>
    <DataSet Name="Ingreso_Mesual_Empresa">
      <Query>
        <DataSourceName>Inicio</DataSourceName>
        <CommandText>SELECT YEAR(OrderDate) AS OrderYear,MONTH(OrderDate) AS OrderMonth,ROUND(SUM(TotalDue), 2) AS TotalRevenue
FROM Sales.SalesOrderHeader
GROUP BY YEAR(OrderDate),MONTH(OrderDate)
ORDER BY OrderYear DESC,OrderMonth DESC;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="OrderYear">
          <DataField>OrderYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderMonth">
          <DataField>OrderMonth</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalRevenue">
          <DataField>TotalRevenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="IngresoMensualPais">
      <Query>
        <DataSourceName>Inicio</DataSourceName>
        <CommandText>SELECT cr.Name AS Country,YEAR(soh.OrderDate) AS OrderYear,MONTH(soh.OrderDate) AS OrderMonth,ROUND(SUM(soh.TotalDue), 2) AS TotalRevenue
FROM Sales.SalesOrderHeader AS soh 
INNER JOIN Sales.SalesTerritory AS st ON soh.TerritoryID = st.TerritoryID
INNER JOIN Person.CountryRegion AS cr ON cr.CountryRegionCode = st.CountryRegionCode
GROUP BY cr.Name,YEAR(soh.OrderDate),MONTH(soh.OrderDate)
ORDER BY OrderYear DESC,OrderMonth DESC,Country;</CommandText>
      </Query>
      <Fields>
        <Field Name="Country">
          <DataField>Country</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderYear">
          <DataField>OrderYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderMonth">
          <DataField>OrderMonth</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalRevenue">
          <DataField>TotalRevenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Productos_Mas_Vendidos">
      <Query>
        <DataSourceName>Inicio</DataSourceName>
        <CommandText>SELECT TOP 10 p.ProductID,p.Name AS ProductName,SUM(od.OrderQty) AS TotalUnitsSold
FROM Sales.SalesOrderDetail AS od
INNER JOIN Production.Product AS p ON od.ProductID = p.ProductID
GROUP BY p.ProductID,p.Name
ORDER BY TotalUnitsSold DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="ProductID">
          <DataField>ProductID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ProductName">
          <DataField>ProductName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalUnitsSold">
          <DataField>TotalUnitsSold</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Ingresos_OnLine_OffLine">
      <Query>
        <DataSourceName>Inicio</DataSourceName>
        <CommandText>SELECT
CASE 
	WHEN OnlineOrderFlag = 1 THEN 'Online' 
	ELSE 'Store' 
END AS OrderOrigin,
YEAR(OrderDate) AS OrderYear,
MONTH(OrderDate) AS OrderMonth,
COUNT(SalesOrderID) AS TotalSales,
SUM(TotalDue) AS TotalRevenue
FROM Sales.SalesOrderHeader
--WHERE OrderDate &gt; DATEADD(YEAR, -15, GETDATE())
GROUP BY OnlineOrderFlag,YEAR(OrderDate),MONTH(OrderDate)
ORDER BY 1,2,3;</CommandText>
      </Query>
      <Fields>
        <Field Name="OrderOrigin">
          <DataField>OrderOrigin</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderYear">
          <DataField>OrderYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderMonth">
          <DataField>OrderMonth</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalSales">
          <DataField>TotalSales</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalRevenue">
          <DataField>TotalRevenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Tiendas_Que_Venden_Mas">
      <Query>
        <DataSourceName>Inicio</DataSourceName>
        <CommandText>SELECT TOP 10 COALESCE(s.Name, 'Online') AS StoreName,ROUND(SUM(so.TotalDue), 2) AS TotalSalesAmount
FROM Sales.SalesOrderHeader AS so
LEFT JOIN Sales.Store AS s ON so.SalesPersonID = s.SalesPersonID
--WHERE so.OrderDate &gt; DATEADD(YEAR, -15, GETDATE())--PARA VER LO QUE HAY SE LE PUSO 15 AÑOS
GROUP BY s.Name
ORDER BY TotalSalesAmount DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="StoreName">
          <DataField>StoreName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalSalesAmount">
          <DataField>TotalSalesAmount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Promedio_Orden_por_Pais">
      <Query>
        <DataSourceName>Inicio</DataSourceName>
        <CommandText>
WITH OrderSizes AS (
  SELECT sod.SalesOrderID,SUM(sod.OrderQty) AS ProductCount,cr.Name AS Country
  FROM Sales.SalesOrderHeader AS soh
  INNER JOIN Sales.SalesOrderDetail AS sod ON sod.SalesOrderID = soh.SalesOrderID
  INNER JOIN Sales.SalesTerritory AS st ON soh.TerritoryID = st.TerritoryID
  INNER JOIN Person.CountryRegion AS cr ON cr.CountryRegionCode = st.CountryRegionCode
  GROUP BY sod.SalesOrderID,cr.Name
)
SELECT
  Country, 
  ROUND(AVG(CAST(ProductCount AS FLOAT)), 2) AS AverageOrderSize
FROM OrderSizes
GROUP BY Country
ORDER BY AverageOrderSize DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="Country">
          <DataField>Country</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AverageOrderSize">
          <DataField>AverageOrderSize</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
