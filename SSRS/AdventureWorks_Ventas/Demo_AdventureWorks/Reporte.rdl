  <DataSets>
    <DataSet Name="Reporte_Venta">
      <Query>
        <DataSourceName>AdventureWorks</DataSourceName>
        <CommandText>SELECT 
SalesOrderDetailID,
YEAR(OrderDate) AS OrderYear,
MONTH(OrderDate) AS OrderMonth,
CarrierTrackingNumber,
cr.Name AS Country,
IIF(OnlineOrderFlag=0,'OffLine','OnLine') AS TipoCompra,
CC.CardType,
--COALESCE(s.Name, 'Online') AS StoreName,
P.Name AS Product,
OrderQty,
SO.Description AS NameOfert,
SO.Type AS TypeOfert,
SO.Category AS CategoryOfert,
(ROUND(SubTotal,2)) AS SubTotal,
(ROUND(TaxAmt,2)) AS TaxAmt,
(ROUND(Freight,2)) AS Freight,
(ROUND(TotalDue, 2)) AS TotalRevenue
--SELECT COUNT(1)
FROM [Sales].[SalesOrderDetail] AS A--121 317
LEFT JOIN Sales.SalesOrderHeader AS soh ON soh.SalesOrderID=A.SalesOrderID--121 317
INNER JOIN Sales.SalesTerritory AS st ON soh.TerritoryID = st.TerritoryID
INNER JOIN Person.CountryRegion AS cr ON cr.CountryRegionCode = st.CountryRegionCode
--LEFT JOIN Sales.Store AS s ON soh.SalesPersonID = s.SalesPersonID
LEFT JOIN [Sales].[CreditCard] AS CC ON SOH.CreditCardID=CC.CreditCardID--121 317
LEFT JOIN [Production].[Product] AS P ON P.ProductID=A.ProductID--121317
LEFT JOIN [Sales].[SpecialOffer] AS SO ON SO.SpecialOfferID=A.SpecialOfferID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
