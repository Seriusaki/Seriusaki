      <Filters>
        <Filter>
          <FilterExpression>=Fields!OrderYear.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Año.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!OrderMonth.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!MES.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="FiltroAnio">
      <Query>
        <DataSourceName>AdventureWorks</DataSourceName>
        <CommandText>SELECT 
YEAR(OrderDate) AS OrderYear
FROM Sales.SalesOrderHeader
GROUP BY YEAR(OrderDate)
ORDER BY 1</CommandText>
      </Query>
      <Fields>
        <Field Name="OrderYear">
          <DataField>OrderYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="FiltroMes">
      <Query>
        <DataSourceName>AdventureWorks</DataSourceName>
        <CommandText>SELECT 
MONTH(OrderDate) AS OrderMonth,
FORMAT(OrderDate, 'MMMM') AS MES
FROM Sales.SalesOrderHeader
GROUP BY MONTH(OrderDate),FORMAT(OrderDate, 'MMMM')
ORDER BY 1</CommandText>
      </Query>
      <Fields>
        <Field Name="OrderMonth">
          <DataField>OrderMonth</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MES">
          <DataField>MES</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
